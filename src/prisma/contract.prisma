// use prisma-8

model Workout {
  id        Int        @id @default(autoincrement())
  date      String
  exercises Exercise[]
}

model Exercise {
  id        Int     @id @default(autoincrement())
  workoutId Int
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  type      String
  place     String
  details   String?
}
